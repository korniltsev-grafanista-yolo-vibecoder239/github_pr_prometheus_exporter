# GitHub personal access token (needs repo read access)
GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# Comma-separated list of repositories to monitor (owner/repo)
GITHUB_REPOS=prometheus/prometheus,grafana/grafana

# Grafana Cloud Prometheus remote write endpoint
REMOTE_WRITE_URL=https://prometheus-prod-01-prod-us-east-0.grafana.net/api/prom/push

# Grafana Cloud instance ID (username for basic auth)
REMOTE_WRITE_USERNAME=123456

# Grafana Cloud API key (password for basic auth)
REMOTE_WRITE_PASSWORD=glc_xxxxxxxxxxxx

# How often to poll GitHub (default: 60s)
# POLL_INTERVAL=60s
